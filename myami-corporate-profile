    <a href="#market">Market</a>
    <a href="#positioning">Positioning</a>
  </div>

  <div class="nav-group">
    <span class="nav-group-label">Identity</span>
    <a href="#culture">Culture</a>
    <a href="#founder">Leadership</a>
