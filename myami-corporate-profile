<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

<title>MYAMI — Corporate Profile</title>

<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500;1,600&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet"/>

<style>
*,
*::before,
*::after{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

:root{
  --black:#09090A;
  --warm:#141210;
  --ash:#252220;
  --ash-mid:#332F2A;

  --gold:#C8A84B;
  --gold-lt:#E8C96A;
  --gold-dk:#7A6225;

  --linen:#F2EDE4;
  --cream:#DDD5C3;
  --muted:#6B6357;
  --muted-lt:#8A8077;

  --fd:'Syne',sans-serif;
  --fs:'Cormorant Garamond',serif;
  --fm:'DM Mono',monospace;
}

html{
  scroll-behavior:smooth;
}

body{
  background:var(--black);
  color:var(--linen);
  font-family:var(--fs);
  overflow-x:hidden;
}

/* FILM GRAIN */

body::before{
  content:'';
  position:fixed;
  inset:0;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.045'/%3E%3C/svg%3E");
  pointer-events:none;
  z-index:9000;
}

/* SIDEBAR */

.sidebar{
  position:fixed;
  left:0;
  top:0;
  bottom:0;
  width:220px;
  background:var(--warm);
  border-right:1px solid var(--ash);
  padding:40px 0;
  z-index:100;
  overflow-y:auto;
  display:flex;
  flex-direction:column;
}

.sidebar-logo{
  font-family:var(--fd);
  font-size:16px;
  font-weight:800;
  letter-spacing:.18em;
  color:var(--linen);
  padding:0 28px 28px;
  border-bottom:1px solid var(--ash);
  margin-bottom:24px;
}

.sidebar-logo .a{
  color:var(--gold);
}

.sidebar-doc{
  font-family:var(--fm);
  font-size:7px;
  letter-spacing:.2em;
  text-transform:uppercase;
  color:var(--muted);
  display:block;
  margin-top:5px;
}

.nav-group{
  margin-bottom:18px;
}

.nav-group-label{
  font-family:var(--fm);
  font-size:7px;
  letter-spacing:.25em;
  text-transform:uppercase;
  color:var(--gold-dk);
  padding:0 28px 8px;
  display:block;
}

.sidebar a{
  display:block;
  font-family:var(--fm);
  font-size:10px;
  letter-spacing:.1em;
  color:var(--muted);
  text-decoration:none;
  padding:8px 28px;
  border-left:2px solid transparent;
  transition:.25s;
  line-height:1.4;
}

.sidebar a:hover,
.sidebar a.active{
  color:var(--linen);
  background:rgba(200,168,75,.05);
  border-left-color:var(--gold);
}

.sidebar-footer{
  margin-top:auto;
  padding:20px 28px 0;
  border-top:1px solid var(--ash);
  font-family:var(--fm);
  font-size:7px;
  letter-spacing:.12em;
  color:var(--muted);
  line-height:2;
}

/* MAIN */

.main{
  margin-left:220px;
}

/* HERO */

.hero{
  min-height:100vh;
  padding:64px 80px;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  position:relative;
  overflow:hidden;
  border-bottom:1px solid var(--ash);
}

.hero-glow{
  position:absolute;
  width:750px;
  height:750px;
  border-radius:50%;
  background:radial-gradient(
    circle,
    rgba(200,168,75,.09) 0%,
    transparent 68%
  );
  top:-300px;
  right:-180px;
}

.hero-grid{
  position:absolute;
  inset:0;
  background-image:
    linear-gradient(rgba(200,168,75,.025) 1px,transparent 1px),
    linear-gradient(90deg,rgba(200,168,75,.025) 1px,transparent 1px);
  background-size:56px 56px;
}

.hero-top{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  position:relative;
  z-index:2;
}

.badge{
  font-family:var(--fm);
  font-size:8px;
  letter-spacing:.25em;
  text-transform:uppercase;
  color:var(--gold);
  border:1px solid var(--gold-dk);
  padding:7px 15px;
}

.hero-ref{
  font-family:var(--fm);
  font-size:8px;
  letter-spacing:.15em;
  color:var(--muted);
  text-align:right;
  line-height:2;
}

.hero-center{
  position:relative;
  z-index:2;
}

.eyebrow{
  font-family:var(--fm);
  font-size:9px;
  letter-spacing:.35em;
  text-transform:uppercase;
  color:var(--gold);
  margin-bottom:28px;
  display:flex;
  align-items:center;
  gap:14px;
}

.eyebrow::before{
  content:'';
  width:25px;
  height:1px;
  background:var(--gold);
}

.wordmark{
  font-family:var(--fd);
  font-size:clamp(80px,11vw,155px);
  font-weight:800;
  letter-spacing:.06em;
  line-height:.88;
  margin-bottom:32px;
}

.wordmark .a{
  color:var(--gold);
}

.hero-title{
  font-family:var(--fs);
  font-size:clamp(25px,3vw,40px);
  line-height:1.25;
  font-weight:300;
  font-style:italic;
  color:var(--linen);
  max-width:850px;
}

.hero-title em{
  color:var(--gold);
  font-style:normal;
  font-weight:500;
}

.hero-bottom{
  display:flex;
  justify-content:space-between;
  align-items:flex-end;
  position:relative;
  z-index:2;
}

.hero-description{
  max-width:590px;
  border-left:2px solid var(--gold-dk);
  padding-left:22px;
  font-family:var(--fs);
  font-size:17px;
  line-height:1.85;
  color:var(--muted-lt);
}

.hero-meta{
  font-family:var(--fm);
  font-size:8px;
  line-height:2;
  letter-spacing:.12em;
  color:var(--muted);
  text-align:right;
}

/* SECTIONS */

.section{
  padding:90px 80px;
  border-bottom:1px solid var(--ash);
}

.section-label{
  font-family:var(--fm);
  font-size:8px;
  letter-spacing:.32em;
  text-transform:uppercase;
  color:var(--gold);
  margin-bottom:40px;
  display:flex;
  align-items:center;
  gap:12px;
}

.section-label::before{
  content:'';
  width:20px;
  height:1px;
  background:var(--gold);
}

h2{
  font-family:var(--fd);
  font-size:clamp(28px,3.5vw,46px);
  font-weight:800;
  letter-spacing:.02em;
  line-height:1.05;
  color:var(--linen);
  margin-bottom:28px;
}

h3{
  font-family:var(--fd);
  font-size:13px;
  font-weight:700;
  letter-spacing:.16em;
  text-transform:uppercase;
  color:var(--gold);
  margin-bottom:16px;
  margin-top:45px;
}

.body-copy{
  max-width:730px;
  font-family:var(--fs);
  font-size:18px;
  line-height:1.9;
  color:var(--muted-lt);
  margin-bottom:22px;
}

.body-copy strong{
  color:var(--linen);
  font-weight:500;
}

/* STATEMENT */

.statement{
  font-family:var(--fs);
  font-size:clamp(28px,4vw,52px);
  line-height:1.2;
  font-style:italic;
  font-weight:300;
  max-width:850px;
  margin:40px 0;
  color:var(--linen);
}

.statement em{
  color:var(--gold);
  font-style:normal;
  font-weight:500;
}

/* CALLOUT */

.callout{
  max-width:760px;
  background:var(--warm);
  border-left:3px solid var(--gold);
  padding:30px 35px;
  margin:38px 0;
}

.callout p{
  font-family:var(--fs);
  font-size:21px;
  font-style:italic;
  line-height:1.5;
  color:var(--linen);
}

.callout em{
  color:var(--gold);
  font-style:normal;
}

/* CARDS */

.grid-2{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:2px;
  margin-top:45px;
}

.grid-3{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:2px;
  margin-top:45px;
}

.grid-4{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:2px;
  margin-top:45px;
}

.card{
  background:var(--warm);
  padding:34px;
  min-height:210px;
  position:relative;
  overflow:hidden;
}

.card::after{
  content:'';
  position:absolute;
  left:0;
  bottom:0;
  width:0;
  height:2px;
  background:var(--gold);
  transition:.4s;
}

.card:hover::after{
  width:100%;
}

.card-label{
  font-family:var(--fm);
  font-size:8px;
  letter-spacing:.22em;
  text-transform:uppercase;
  color:var(--gold);
  margin-bottom:12px;
}

.card-title{
  font-family:var(--fd);
  font-size:19px;
  font-weight:700;
  color:var(--linen);
  margin-bottom:13px;
}

.card p{
  font-family:var(--fs);
  font-size:14px;
  line-height:1.8;
  color:var(--muted);
}

/* VALUES */

.value-number{
  font-family:var(--fm);
  font-size:8px;
  letter-spacing:.2em;
  color:var(--gold-dk);
  margin-bottom:25px;
}

/* DIVISIONS */

.division{
  background:var(--warm);
  margin-top:3px;
  padding:42px;
  display:grid;
  grid-template-columns:180px 1fr 230px;
  gap:40px;
  align-items:start;
  position:relative;
  overflow:hidden;
}

.division-number{
  font-family:var(--fm);
  font-size:8px;
  letter-spacing:.25em;
  color:var(--gold-dk);
}

.division-name{
  font-family:var(--fd);
  font-size:30px;
  font-weight:800;
  letter-spacing:.06em;
  color:var(--linen);
  line-height:1;
}

.division-name .a{
  color:var(--gold);
}

.division-type{
  font-family:var(--fm);
  font-size:8px;
  letter-spacing:.2em;
  text-transform:uppercase;
  color:var(--gold);
  margin-top:8px;
}

.division-description{
  font-family:var(--fs);
  font-size:16px;
  line-height:1.8;
  color:var(--muted-lt);
}

.division-services{
  display:flex;
  flex-direction:column;
}

.service{
  font-family:var(--fm);
  font-size:8px;
  letter-spacing:.1em;
  color:var(--muted);
  padding:9px 0;
  border-bottom:1px solid var(--ash);
}

.service:first-child{
  border-top:1px solid var(--ash);
}

/* POSITIONING */

.position-box{
  margin-top:45px;
  border:1px solid var(--ash);
  background:var(--warm);
  padding:50px;
  text-align:center;
}

.position-box .large{
  font-family:var(--fd);
  font-size:clamp(30px,4vw,58px);
  font-weight:800;
  line-height:1.1;
  color:var(--linen);
}

.position-box .large span{
  color:var(--gold);
}

/* AUDIENCE */

.audience{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:2px;
  margin-top:45px;
}

.audience-card{
  background:var(--warm);
  padding:35px;
}

.audience-card h4{
  font-family:var(--fd);
  font-size:17px;
  color:var(--linen);
  margin-bottom:12px;
}

.audience-card p{
  font-family:var(--fs);
  font-size:14px;
  line-height:1.8;
  color:var(--muted);
}

/* ECOSYSTEM */

.ecosystem{
  margin-top:50px;
  display:flex;
  flex-direction:column;
  align-items:center;
}

.eco-center{
  width:190px;
  height:190px;
  border:1px solid var(--gold-dk);
  border-radius:50%;
  display:flex;
  justify-content:center;
  align-items:center;
  flex-direction:column;
  background:var(--warm);
  position:relative;
  z-index:2;
}

.eco-center-name{
  font-family:var(--fd);
  font-size:27px;
  font-weight:800;
  letter-spacing:.1em;
}

.eco-center-name span{
  color:var(--gold);
}

.eco-center-sub{
  font-family:var(--fm);
  font-size:7px;
  letter-spacing:.2em;
  text-transform:uppercase;
  color:var(--muted);
  margin-top:8px;
}

.eco-line{
  width:1px;
  height:55px;
  background:var(--gold-dk);
}

.eco-divisions{
  width:100%;
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:2px;
}

.eco-card{
  background:var(--warm);
  padding:28px 20px;
  text-align:center;
}

.eco-card-name{
  font-family:var(--fd);
  font-size:15px;
  font-weight:700;
  color:var(--linen);
  margin-bottom:6px;
}

.eco-card p{
  font-family:var(--fs);
  font-size:12px;
  line-height:1.6;
  color:var(--muted);
}

/* CULTURE */

.culture-grid{
  display:grid;
  grid-template-columns:1.3fr .7fr;
  gap:2px;
  margin-top:45px;
}

.culture-main{
  background:var(--warm);
  padding:50px;
}

.culture-main h3{
  margin-top:0;
}

.culture-side{
  display:flex;
  flex-direction:column;
  gap:2px;
}

.culture-small{
  flex:1;
  background:var(--warm);
  padding:30px;
}

.culture-small h4{
  font-family:var(--fd);
  color:var(--linen);
  font-size:15px;
  margin-bottom:8px;
}

.culture-small p{
  font-family:var(--fs);
  font-size:13px;
  line-height:1.7;
  color:var(--muted);
}

/* FOUNDER */

.founder{
  display:grid;
  grid-template-columns:280px 1fr;
  gap:55px;
  margin-top:45px;
}

.founder-mark{
  background:var(--warm);
  min-height:280px;
  display:flex;
  align-items:center;
  justify-content:center;
  position:relative;
}

.founder-mark::before{
  content:'M';
  font-family:var(--fd);
  font-size:150px;
  font-weight:800;
  color:rgba(200,168,75,.07);
}

.founder-info{
  padding-top:10px;
}

.founder-role{
  font-family:var(--fm);
  font-size:8px;
  letter-spacing:.25em;
  text-transform:uppercase;
  color:var(--gold);
  margin-bottom:12px;
}

.founder-name{
  font-family:var(--fd);
  font-size:35px;
  font-weight:800;
  color:var(--linen);
  margin-bottom:20px;
}

/* DIRECTION */

.direction{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:2px;
  margin-top:45px;
}

.direction-card{
  background:var(--warm);
  padding:40px 30px;
  border-top:2px solid var(--gold-dk);
}

.direction-card:nth-child(2){
  border-top-color:var(--gold);
}

.direction-card:nth-child(3){
  border-top-color:var(--gold-lt);
}

.direction-card .period{
  font-family:var(--fm);
  font-size:8px;
  letter-spacing:.2em;
  color:var(--gold);
  text-transform:uppercase;
  margin-bottom:12px;
}

.direction-card h4{
  font-family:var(--fd);
  font-size:20px;
  color:var(--linen);
  margin-bottom:12px;
}

.direction-card p{
  font-family:var(--fs);
  font-size:14px;
  line-height:1.8;
  color:var(--muted);
}

/* CLOSING */

.closing{
  min-height:70vh;
  padding:110px 80px;
  background:var(--warm);
  text-align:center;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  position:relative;
  overflow:hidden;
}

.closing-watermark{
  position:absolute;
  left:50%;
  top:50%;
  transform:translate(-50%,-50%);
  font-family:var(--fd);
  font-size:clamp(100px,17vw,230px);
  font-weight:800;
  letter-spacing:.05em;
  color:rgba(200,168,75,.035);
  white-space:nowrap;
}

.closing-label{
  font-family:var(--fm);
  font-size:8px;
  letter-spacing:.35em;
  text-transform:uppercase;
  color:var(--gold);
  margin-bottom:32px;
  position:relative;
  z-index:1;
}

.closing-statement{
  max-width:850px;
  font-family:var(--fs);
  font-size:clamp(30px,4.5vw,58px);
  line-height:1.2;
  font-style:italic;
  font-weight:300;
  color:var(--linen);
  position:relative;
  z-index:1;
}

.closing-statement em{
  color:var(--gold);
  font-style:normal;
}

.closing-logo{
  margin-top:55px;
  font-family:var(--fd);
  font-size:30px;
  font-weight:800;
  letter-spacing:.2em;
  position:relative;
  z-index:1;
}

.closing-logo span{
  color:var(--gold);
}

.closing-meta{
  margin-top:10px;
  font-family:var(--fm);
  font-size:8px;
  letter-spacing:.25em;
  color:var(--muted);
  text-transform:uppercase;
  position:relative;
  z-index:1;
}

/* REVEAL */

.reveal{
  opacity:0;
  transform:translateY(25px);
  transition:
    opacity .8s ease,
    transform .8s ease;
}

.reveal.visible{
  opacity:1;
  transform:translateY(0);
}

/* MOBILE */

@media(max-width:1050px){

  .sidebar{
    display:none;
  }

  .main{
    margin-left:0;
  }

  .hero,
  .section,
  .closing{
    padding:55px 28px;
  }

  .grid-2,
  .grid-3,
  .grid-4,
  .audience,
  .direction,
  .eco-divisions{
    grid-template-columns:1fr;
  }

  .division{
    grid-template-columns:1fr;
    gap:22px;
  }

  .culture-grid{
    grid-template-columns:1fr;
  }

  .founder{
    grid-template-columns:1fr;
  }

  .hero-bottom{
    flex-direction:column;
    align-items:flex-start;
    gap:35px;
  }

  .hero-meta{
    text-align:left;
  }

  .eco-center{
    width:150px;
    height:150px;
  }
}

@media(max-width:600px){

  .hero{
    min-height:100svh;
  }

  .hero-top{
    flex-direction:column;
    gap:20px;
  }

  .hero-ref{
    text-align:left;
  }

  .wordmark{
    font-size:68px;
  }

  .statement{
    font-size:31px;
  }

  .position-box{
    padding:30px 20px;
  }

  .culture-main{
    padding:32px;
  }

  .founder-mark{
    min-height:200px;
  }
}
</style>
</head>

