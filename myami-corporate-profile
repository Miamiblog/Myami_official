  <div class="sidebar-logo">
    MY<span class="a">A</span>MI
    <span class="sidebar-doc">Corporate Profile</span>
  </div>

  <div class="nav-group">
    <span class="nav-group-label">Company</span>
    <a href="#overview">Overview</a>
