    2026 · Confidential
  </div>

</nav>


<main class="main">

<!-- HERO -->

<section class="hero" id="overview">

  <div class="hero-glow"></div>
  <div class="hero-grid"></div>

  <div class="hero-top">

    <div class="badge">
      Company Profile
    </div>

    <div class="hero-ref">
      MYAMI-CORP-001<br/>
      Established · Building
    </div>

  </div>

  <div class="hero-center">

    <div class="eyebrow">
      About MYAMI
    </div>

    <div class="wordmark">
      MY<span class="a">A</span>MI
