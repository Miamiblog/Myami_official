<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>MYAMI — Investor Overview</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500;1,600&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
:root{
  --black:#09090A;--warm:#141210;--ash:#252220;--ash-mid:#332F2A;
  --gold:#C8A84B;--gold-lt:#E8C96A;--gold-dk:#7A6225;
  --linen:#F2EDE4;--cream:#DDD5C3;--muted:#6B6357;--muted-lt:#8A8077;
  --fd:'Syne',sans-serif;--fs:'Cormorant Garamond',serif;--fm:'DM Mono',monospace;
}
html{scroll-behavior:smooth;}
body{background:var(--black);color:var(--linen);font-family:var(--fs);overflow-x:hidden;}
body::before{content:'';position:fixed;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.045'/%3E%3C/svg%3E");pointer-events:none;z-index:9000;}

/* SIDEBAR */
.sidebar{position:fixed;left:0;top:0;bottom:0;width:220px;background:var(--warm);border-right:1px solid var(--ash);padding:40px 0;z-index:100;overflow-y:auto;display:flex;flex-direction:column;}
.sidebar-logo{font-family:var(--fd);font-size:16px;font-weight:800;letter-spacing:.18em;color:var(--linen);padding:0 28px 28px;border-bottom:1px solid var(--ash);margin-bottom:24px;}
.sidebar-logo .a{color:var(--gold);}
.sidebar-doc{font-family:var(--fm);font-size:7px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);display:block;margin-top:5px;}
.nav-grp-label{font-family:var(--fm);font-size:7px;letter-spacing:.25em;text-transform:uppercase;color:var(--gold-dk);padding:0 28px 8px;margin-top:12px;display:block;}
.sidebar a{display:block;font-family:var(--fm);font-size:10px;letter-spacing:.1em;color:var(--muted);text-decoration:none;padding:8px 28px;border-left:2px solid transparent;transition:all .2s;line-height:1.4;}
.sidebar a:hover,.sidebar a.active{color:var(--linen);background:rgba(200,168,75,.05);border-left-color:var(--gold);}
.sidebar-footer{margin-top:auto;padding:20px 28px 0;border-top:1px solid var(--ash);font-family:var(--fm);font-size:7px;letter-spacing:.12em;color:var(--muted);line-height:2;}

/* MAIN */
.main{margin-left:220px;}

/* COVER */
.cover{min-height:100vh;display:flex;flex-direction:column;justify-content:space-between;padding:64px 80px;position:relative;overflow:hidden;border-bottom:1px solid var(--ash);}
.cover-glow{position:absolute;width:700px;height:700px;border-radius:50%;background:radial-gradient(circle,rgba(200,168,75,.08) 0%,transparent 65%);top:-200px;right:-100px;pointer-events:none;}
.cover-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(200,168,75,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(200,168,75,.03) 1px,transparent 1px);background-size:56px 56px;pointer-events:none;}
.cover-top{display:flex;justify-content:space-between;align-items:flex-start;position:relative;z-index:1;}
.cover-badge{font-family:var(--fm);font-size:8px;letter-spacing:.25em;text-transform:uppercase;color:var(--gold);border:1px solid var(--gold-dk);padding:6px 16px;}
.cover-ref{font-family:var(--fm);font-size:8px;letter-spacing:.15em;color:var(--muted);text-align:right;line-height:2;}
.cover-center{position:relative;z-index:1;}
.cover-eyebrow{font-family:var(--fm);font-size:9px;letter-spacing:.35em;text-transform:uppercase;color:var(--gold);margin-bottom:28px;display:flex;align-items:center;gap:14px;}
.cover-eyebrow::before{content:'';display:block;width:24px;height:1px;background:var(--gold);}
.cover-wordmark{font-family:var(--fd);font-size:clamp(72px,10vw,140px);font-weight:800;letter-spacing:.06em;line-height:.9;margin-bottom:32px;}
.cover-wordmark .a{color:var(--gold);}
.cover-wordmark .outline{-webkit-text-stroke:1.5px rgba(242,237,228,.18);color:transparent;}
.cover-title{font-family:var(--fs);font-size:22px;font-style:italic;font-weight:300;color:var(--muted-lt);margin-bottom:40px;}
.cover-title em{color:var(--gold);font-style:normal;font-weight:500;}
.cover-summary{font-family:var(--fs);font-size:17px;line-height:1.85;color:var(--muted-lt);max-width:580px;border-left:2px solid var(--gold-dk);padding-left:22px;}
.cover-bottom{display:flex;justify-content:space-between;align-items:flex-end;position:relative;z-index:1;}
.cover-stats{display:flex;gap:2px;}
.cover-stat{background:var(--warm);border:1px solid var(--ash);padding:16px 20px;text-align:center;}
.cover-stat-num{font-family:var(--fd);font-size:24px;font-weight:800;color:var(--gold);line-height:1;}
.cover-stat-label{font-family:var(--fm);font-size:7px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);margin-top:4px;}
.cover-prepared{font-family:var(--fm);font-size:8px;letter-spacing:.15em;color:var(--muted);text-align:right;line-height:2;}

/* SECTION */
.sec{padding:72px 80px;border-bottom:1px solid var(--ash);}
.sec:last-child{border-bottom:none;}
.sec-label{font-family:var(--fm);font-size:8px;letter-spacing:.32em;text-transform:uppercase;color:var(--gold);margin-bottom:40px;display:flex;align-items:center;gap:12px;}
.sec-label::before{content:'';display:block;width:20px;height:1px;background:var(--gold);}
h2{font-family:var(--fd);font-size:clamp(26px,3.2vw,40px);font-weight:800;letter-spacing:.03em;color:var(--linen);margin-bottom:24px;}
h3{font-family:var(--fd);font-size:13px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);margin-bottom:16px;margin-top:40px;}
h3:first-child{margin-top:0;}
p.bd{font-family:var(--fs);font-size:17px;line-height:1.9;color:var(--muted-lt);margin-bottom:20px;max-width:680px;}
p.bd strong{color:var(--linen);font-weight:500;}
p.bd:last-child{margin-bottom:0;}
.statement{font-family:var(--fs);font-size:clamp(24px,3vw,40px);font-style:italic;font-weight:300;line-height:1.25;color:var(--linen);margin:36px 0;max-width:700px;}
.statement em{font-style:normal;color:var(--gold);font-weight:500;}
.callout{background:var(--warm);border-left:3px solid var(--gold);padding:26px 32px;margin:32px 0;max-width:680px;}
.callout p{font-family:var(--fs);font-size:19px;font-style:italic;color:var(--linen);margin:0;max-width:none;}
.callout p em{color:var(--gold);font-style:normal;font-weight:500;}

/* GRIDS */
.g2{display:grid;grid-template-columns:1fr 1fr;gap:2px;margin:32px 0;}
.g3{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;margin:32px 0;}
.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:2px;margin:32px 0;}
.card{background:var(--warm);padding:32px;}
.card-label{font-family:var(--fm);font-size:8px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);margin-bottom:10px;}
.card-title{font-family:var(--fd);font-size:17px;font-weight:700;letter-spacing:.04em;color:var(--linen);margin-bottom:10px;}
.card p{font-family:var(--fs);font-size:13px;line-height:1.75;color:var(--muted);margin:0;}

/* OPPORTUNITY */
.opp-block{background:var(--warm);padding:40px;margin:4px 0;position:relative;overflow:hidden;transition:background .3s;}
.opp-block::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--gold);transform:scaleX(0);transform-origin:left;transition:transform .4s;}
.opp-block:hover::before{transform:scaleX(1);}
.opp-block:hover{background:#181512;}
.opp-inner{display:grid;grid-template-columns:180px 1fr 200px;gap:40px;align-items:start;}
.opp-num{font-family:var(--fm);font-size:8px;letter-spacing:.25em;color:var(--gold-dk);}
.opp-name{font-family:var(--fd);font-size:28px;font-weight:800;letter-spacing:.06em;color:var(--linen);line-height:1;margin-bottom:4px;}
.opp-name .a{color:var(--gold);}
.opp-arm{font-family:var(--fm);font-size:9px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);margin-bottom:16px;}
.opp-desc{font-family:var(--fs);font-size:15px;line-height:1.8;color:var(--muted-lt);}
.opp-services{display:flex;flex-direction:column;gap:0;}
.opp-service{font-family:var(--fm);font-size:9px;letter-spacing:.1em;color:var(--muted);padding:8px 0;border-bottom:1px solid var(--ash);}
.opp-service:first-child{border-top:1px solid var(--ash);}
.opp-big{position:absolute;right:40px;bottom:16px;font-family:var(--fd);font-size:80px;font-weight:800;color:rgba(200,168,75,.04);line-height:1;pointer-events:none;}

/* REVENUE TABLE */
.rev-table{margin:32px 0;border:1px solid var(--ash);}
.rev-header{background:var(--ash);padding:14px 24px;display:grid;grid-template-columns:1fr 160px 160px;gap:16px;border-bottom:1px solid var(--ash-mid);}
.rev-hcell{font-family:var(--fm);font-size:7px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);}
.rev-row{padding:16px 24px;display:grid;grid-template-columns:1fr 160px 160px;gap:16px;border-bottom:1px solid rgba(37,34,32,.5);align-items:center;transition:background .2s;}
.rev-row:last-child{border-bottom:none;}
.rev-row:hover{background:rgba(200,168,75,.03);}
.rev-service{font-family:var(--fs);font-size:15px;color:var(--linen);}
.rev-service small{display:block;font-family:var(--fm);font-size:8px;color:var(--muted);letter-spacing:.08em;margin-top:3px;}
.rev-price{font-family:var(--fm);font-size:11px;color:var(--gold);letter-spacing:.05em;}
.rev-type{font-family:var(--fm);font-size:9px;color:var(--muted);letter-spacing:.1em;text-transform:uppercase;}

/* PHASE TIMELINE */
.phases{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;margin:32px 0;}
.phase{background:var(--warm);padding:36px 28px;position:relative;overflow:hidden;}
.phase::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;}
.phase.p1::before{background:var(--gold-dk);}
.phase.p2::before{background:var(--gold);}
.phase.p3::before{background:var(--gold-lt);}
.phase-tag{font-family:var(--fm);font-size:7px;letter-spacing:.22em;text-transform:uppercase;color:var(--muted);margin-bottom:8px;}
.phase-name{font-family:var(--fd);font-size:18px;font-weight:800;letter-spacing:.04em;color:var(--linen);margin-bottom:4px;}
.phase-period{font-family:var(--fm);font-size:9px;letter-spacing:.15em;color:var(--gold);margin-bottom:20px;}
.phase-desc{font-family:var(--fs);font-size:13px;line-height:1.75;color:var(--muted-lt);}
.phase-target{margin-top:20px;padding-top:16px;border-top:1px solid var(--ash);font-family:var(--fm);font-size:8px;letter-spacing:.15em;color:var(--muted);text-transform:uppercase;}
.phase-target span{display:block;font-family:var(--fd);font-size:24px;font-weight:800;color:var(--gold);letter-spacing:0;margin-top:3px;}

/* KPI */
.kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;margin:32px 0;}
.kpi{background:var(--warm);padding:32px;text-align:center;}
.kpi-num{font-family:var(--fd);font-size:40px;font-weight:800;color:var(--gold);line-height:1;margin-bottom:6px;}
.kpi-label{font-family:var(--fm);font-size:8px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);}
.kpi-desc{font-family:var(--fs);font-size:12px;font-style:italic;color:var(--muted);margin-top:6px;line-height:1.5;}

/* WHY NOW */
.why-list{margin:32px 0;max-width:700px;}
.why-item{display:flex;gap:20px;padding:20px 0;border-bottom:1px solid var(--ash);align-items:flex-start;}
.why-item:first-child{border-top:1px solid var(--ash);}
.why-mark{font-family:var(--fm);font-size:8px;letter-spacing:.15em;color:var(--gold);flex-shrink:0;margin-top:4px;text-transform:uppercase;}
.why-text{font-family:var(--fs);font-size:16px;color:var(--muted-lt);line-height:1.7;}
.why-text strong{color:var(--linen);font-weight:500;}

/* INVEST TIERS */
.tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;margin:32px 0;}
.tier{background:var(--warm);padding:36px 28px;position:relative;overflow:hidden;}
.tier.featured{background:#181512;}
.tier.featured::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--gold);}
.tier-label{font-family:var(--fm);font-size:7px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);margin-bottom:12px;}
.tier-name{font-family:var(--fd);font-size:20px;font-weight:800;letter-spacing:.04em;color:var(--linen);margin-bottom:4px;}
.tier-amount{font-family:var(--fd);font-size:32px;font-weight:800;color:var(--gold);margin-bottom:20px;line-height:1;}
.tier-desc{font-family:var(--fs);font-size:13px;line-height:1.75;color:var(--muted-lt);margin-bottom:20px;}
.tier-includes{display:flex;flex-direction:column;gap:0;}
.tier-item{font-family:var(--fm);font-size:9px;letter-spacing:.08em;color:var(--muted);padding:8px 0;border-bottom:1px solid var(--ash);display:flex;align-items:center;gap:10px;}
.tier-item:first-child{border-top:1px solid var(--ash);}
.tier-item::before{content:'';display:block;width:4px;height:4px;border-radius:50%;background:var(--gold-dk);flex-shrink:0;}
.tier-note{font-family:var(--fm);font-size:8px;letter-spacing:.1em;color:var(--muted);margin-top:16px;font-style:italic;}

/* CONTACT CLOSER */
.closer{padding:100px 80px;text-align:center;position:relative;overflow:hidden;background:var(--warm);}
.closer-wm{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);font-family:var(--fd);font-size:clamp(80px,14vw,180px);font-weight:800;color:rgba(200,168,75,.04);white-space:nowrap;pointer-events:none;letter-spacing:.06em;}
.closer-label{font-family:var(--fm);font-size:8px;letter-spacing:.32em;text-transform:uppercase;color:var(--gold);margin-bottom:28px;position:relative;z-index:1;}
.closer-statement{font-family:var(--fs);font-size:clamp(24px,3.5vw,44px);font-style:italic;font-weight:300;color:var(--linen);max-width:680px;margin:0 auto 40px;line-height:1.3;position:relative;z-index:1;}
.closer-statement em{font-style:normal;color:var(--gold);font-weight:500;}
.closer-contact{display:flex;justify-content:center;gap:48px;margin-bottom:40px;position:relative;z-index:1;}
.closer-contact-item{text-align:center;}
.closer-contact-label{font-family:var(--fm);font-size:7px;letter-spacing:.22em;text-transform:uppercase;color:var(--muted);margin-bottom:6px;}
.closer-contact-val{font-family:var(--fs);font-size:16px;color:var(--linen);}
.closer-logo{font-family:var(--fd);font-size:26px;font-weight:800;letter-spacing:.2em;color:var(--linen);position:relative;z-index:1;}
.closer-logo span{color:var(--gold);}
.closer-sub{font-family:var(--fm);font-size:8px;letter-spacing:.25em;text-transform:uppercase;color:var(--muted);margin-top:8px;position:relative;z-index:1;}
.disc{font-family:var(--fm);font-size:8px;letter-spacing:.08em;color:var(--muted);line-height:1.8;max-width:600px;margin:32px auto 0;text-align:center;position:relative;z-index:1;opacity:.6;}

/* REVEAL */
.reveal{opacity:0;transform:translateY(28px);transition:opacity .85s ease,transform .85s ease;}
.reveal.visible{opacity:1;transform:translateY(0);}

/* MOBILE */
@media(max-width:1000px){.sidebar{display:none;}.main{margin-left:0;}.cover,.sec,.closer{padding:48px 28px;}.opp-inner{grid-template-columns:1fr;}.g2,.g3,.g4,.phases,.kpis,.tiers{grid-template-columns:1fr;}.rev-header,.rev-row{grid-template-columns:1fr;}}
</style>
</head>
